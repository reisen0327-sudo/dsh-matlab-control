{
  "name": "dsh-matlab-control",
  "version": "0.1.2",
  "type": "module",
  "description": "MATLAB/Simulink control-engineering assistant for DeepSeek Harness: reuses the MathWorks MATLAB MCP Server (with the Simulink Agentic Toolkit tool registry) and adds Simulink model checks, simulation result summaries, App Designer UI generation, and control-design analysis.",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**",
    "reference/**",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reisen0327-sudo/dsh-matlab-control.git"
  },
  "homepage": "https://github.com/reisen0327-sudo/dsh-matlab-control#readme",
  "bugs": {
    "url": "https://github.com/reisen0327-sudo/dsh-matlab-control/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "matlab",
    "simulink",
    "control-systems",
    "pid",
    "app-designer",
    "mcp"
  ],
  "author": "lagrima",
  "license": "MIT"
}
